#!/bin/bash
# Pre-push hook: Quick validation before push
# Note: Tests run in GitHub Actions, not locally

echo "🔍 Pre-push validation..."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Check that fixture directories exist
for fixture in 01-cache-control 02-security-headers 03-cache-conflict; do
    if [ ! -d "$PROJECT_ROOT/fixtures/$fixture" ]; then
        echo "❌ Missing fixture: $fixture"
        exit 1
    fi
done

echo "✅ All fixtures present"
echo "📝 Tests will run in GitHub Actions and update README"
echo ""
exit 0
